{
  "entities": {
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences, language, scanner thresholds, and auditor profile stored under /users/{userId}/settings/current",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "language": { "type": "string", "enum": ["ar", "en"] },
        "soundEnabled": { "type": "boolean" },
        "vibrationEnabled": { "type": "boolean" },
        "longBarcodeThreshold": { "type": "integer" },
        "auditorName": { "type": "string" },
        "auditorId": { "type": "string" },
        "auditorTitle": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "language", "soundEnabled", "vibrationEnabled", "longBarcodeThreshold", "auditorName", "auditorId", "auditorTitle", "updatedAt"]
    },
    "ReturnReport": {
      "title": "ReturnReport",
      "description": "RMA customer return and lab inspection archive under /users/{userId}/returns/{returnId}",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "returnReceiptNo": { "type": "string" },
        "originalInvoiceNo": { "type": "string" },
        "orderNo": { "type": "string" },
        "customerName": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["COMPLETED_WAREHOUSE", "PENDING_LAB", "DRAFT"] },
        "totalRefundAmount": { "type": "number" },
        "totalItems": { "type": "integer" },
        "auditorName": { "type": "string" },
        "itemsJson": { "type": "string" },
        "notes": { "type": "string" },
        "createdAtIso": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "returnReceiptNo", "originalInvoiceNo", "orderNo", "customerName", "paymentMethod", "status", "totalRefundAmount", "totalItems", "auditorName", "itemsJson", "notes", "createdAtIso", "createdAt", "updatedAt"]
    },
    "AuditDiscrepancy": {
      "title": "AuditDiscrepancy",
      "description": "ISA 500 discrepancy record under /users/{userId}/audit_discrepancies/{discrepancyId}",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "orderNo": { "type": "string" },
        "itemCode": { "type": "string" },
        "itemName": { "type": "string" },
        "unit": { "type": "string" },
        "requiredQty": { "type": "integer" },
        "actualQty": { "type": "integer" },
        "difference": { "type": "integer" },
        "codeStatus": { "type": "string", "enum": ["MATCH", "MISMATCH"] },
        "qtyStatus": { "type": "string", "enum": ["EXACT", "SHORTAGE", "SURPLUS"] },
        "auditorId": { "type": "string" },
        "auditedAtIso": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "invoiceNo", "orderNo", "itemCode", "itemName", "unit", "requiredQty", "actualQty", "difference", "codeStatus", "qtyStatus", "auditorId", "auditedAtIso", "createdAt", "updatedAt"]
    },
    "ReceivingReport": {
      "title": "ReceivingReport",
      "description": "Inbound PO receiving report under /users/{userId}/receiving_reports/{reportId}",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "poNumber": { "type": "string" },
        "supplierName": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "LOCKED"] },
        "totalItems": { "type": "integer" },
        "totalReceivedQty": { "type": "integer" },
        "itemsJson": { "type": "string" },
        "receivedAtIso": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "poNumber", "supplierName", "status", "totalItems", "totalReceivedQty", "itemsJson", "receivedAtIso", "createdAt", "updatedAt"]
    },
    "InventoryReport": {
      "title": "InventoryReport",
      "description": "Physical cycle count archive under /users/{userId}/inventory_reports/{inventoryId}",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "totalItems": { "type": "integer" },
        "totalCountedPieces": { "type": "integer" },
        "itemsJson": { "type": "string" },
        "countedAtIso": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "totalItems", "totalCountedPieces", "itemsJson", "countedAtIso", "createdAt", "updatedAt"]
    },
    "PickingWave": {
      "title": "PickingWave",
      "description": "2-phase picking wave backup under /users/{userId}/picking_waves/{waveId}",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "waveNo": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "APPROVED", "COMPLETED"] },
        "totalInvoices": { "type": "integer" },
        "totalItems": { "type": "integer" },
        "waveJson": { "type": "string" },
        "createdAtIso": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "waveNo", "status", "totalInvoices", "totalItems", "waveJson", "createdAtIso", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User-isolated application and auditor settings"
    },
    "/users/{userId}/returns/{returnId}": {
      "schema": { "$ref": "#/entities/ReturnReport" },
      "description": "User-isolated customer return and lab arbitration reports"
    },
    "/users/{userId}/audit_discrepancies/{discrepancyId}": {
      "schema": { "$ref": "#/entities/AuditDiscrepancy" },
      "description": "User-isolated dispatch audit discrepancies"
    },
    "/users/{userId}/receiving_reports/{reportId}": {
      "schema": { "$ref": "#/entities/ReceivingReport" },
      "description": "User-isolated inbound receiving logs"
    },
    "/users/{userId}/inventory_reports/{inventoryId}": {
      "schema": { "$ref": "#/entities/InventoryReport" },
      "description": "User-isolated physical cycle count reports"
    },
    "/users/{userId}/picking_waves/{waveId}": {
      "schema": { "$ref": "#/entities/PickingWave" },
      "description": "User-isolated 2-phase picking waves"
    }
  }
}
